rocpd_memory_allocate_<uuid>: id,guid,nid,pid,tid,agent_id,type,level,start,end,address,size,queue_id,stream_id,event_id,extdata
rocpd_memory_copy_<uuid>: id,guid,nid,pid,tid,start,end,name_id,dst_agent_id,dst_address,src_agent_id,src_address,size,queue_id,stream_id,region_name_id,event_id,extdata
rocpd_metadata_<uuid>: id,tag,value
