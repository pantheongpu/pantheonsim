rocpd_region_<uuid>: id,guid,nid,pid,tid,start,end,name_id,event_id,extdata
rocpd_sample_<uuid>: id,guid,track_id,timestamp,event_id,extdata
rocpd_string_<uuid>: id,guid,string
rocpd_track_<uuid>: id,guid,nid,pid,tid,name_id,extdata
