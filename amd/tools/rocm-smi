#!/usr/bin/env bash
# Drop-in rocm-smi for VirtualGPU. ROCm is not installed on a CPU-only machine,
# so this provides the command, rendering the same live telemetry.
#
# All arguments go to `vgpu smi --rocm`, which parses them the way rocm-smi
# does -- the same path the session's rocm-smi takes. This script used to
# pick out a few flags itself: `-a` printed the nvidia-smi table and every
# other flag was ignored, while the session's copy rejected the same flags.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
vgpu="$here/vgpu"; [[ -x "$vgpu" ]] || vgpu="$here/../vgpu"
exec -a rocm-smi "$vgpu" smi --rocm "$@"
