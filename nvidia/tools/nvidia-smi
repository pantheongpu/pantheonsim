#!/usr/bin/env bash
# Drop-in nvidia-smi for VirtualGPU.
#
# On a machine with no NVIDIA driver there is no nvidia-smi at all, so this
# provides the command. It renders the same telemetry the NVML shim serves.
# (The *stock* nvidia-smi binary cannot be used against VirtualGPU: it gates
# startup on nvmlInternalGetExportTable, an undocumented internal vtable.
# Tools that use the documented NVML API -- pynvml, DCGM, framework memory
# queries -- work against build/shim/libnvidia-ml.so.1 normally.)
#
# Every argument goes through untouched, --version and -L included. This used
# to answer those two itself: `-L -i 1` became `smi --list` with the selection
# dropped, so it listed every GPU, and --version printed text of its own that
# disagreed with the session's nvidia-smi. `vgpu smi` handles both, in one
# place, for this script and for the one `vgpu shell` generates.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
vgpu="$here/vgpu"
[[ -x "$vgpu" ]] || vgpu="$here/../vgpu"
exec "$vgpu" smi "$@"
