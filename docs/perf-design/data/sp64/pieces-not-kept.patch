+// (Round sp64) The results of a selection's pieces as one: found when every piece is, the functions in the selection's order (the pieces are runs of it).
+// Otherwise the first piece that failed (its status and message), or a plain miss when none failed: a pending selection, some of whose pieces may be in.
+Result Engine::combine(std::vector<Result>& rs) {
+  Result out;
+  unsigned found = 0;
+  for (const Result& x : rs) {
+    found += x.found && !x.compiled ? 1u : 0u;
+    out.compiled |= x.compiled;
+    out.replaced_corrupt |= x.replaced_corrupt;
+    out.pch |= x.pch;
+    out.compile_ms += x.compile_ms;
+    out.lookup_ms += x.lookup_ms;
+    out.source_bytes += x.source_bytes;
+  }
+  out.pieces = static_cast<unsigned>(rs.size());
+  out.pieces_found = found;
+  for (const Result& x : rs)
+    if (!x.found) {
+      out.status = x.status;
+      out.message = x.message;
+      out.cancelled = x.cancelled;
+      out.key = x.key;
+      return out;
+    }
+  auto lib = std::make_shared<Loaded>();
+  for (const Result& x : rs) {
+    lib->fns.insert(lib->fns.end(), x.lib->fns.begin(), x.lib->fns.end());
+    lib->more.push_back(x.lib);
+  }
+  lib->handle = rs.front().lib->handle;
+  out.lib = lib;
+  out.found = true;
+  out.hit = !out.compiled;
+  out.key = rs.front().key;
+  return out;
+}
