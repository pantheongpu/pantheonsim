diff --git a/amd/tests/unit/test_gcn_blocks_same_bits.cpp b/amd/tests/unit/test_gcn_blocks_same_bits.cpp
index cc18b094..f1b769b2 100644
--- a/amd/tests/unit/test_gcn_blocks_same_bits.cpp
+++ b/amd/tests/unit/test_gcn_blocks_same_bits.cpp
@@ -589,4 +589,59 @@ VTEST(row_handlers_of_the_64_bit_forms_inside_blocks) {
   VCHECK(in_blocks * 2 > instructions);
 }
 
+// Bound binary64 operations (Round sp74): runs of v_add_f64, v_mul_f64 and v_fma_f64 on register pairs and constants are their row kernels
+// called one after the other, with any lane on, and an operation whose result has a NaN in a lane that is on is the handler's from there.
+// Doubles without a NaN and every lane on (36), with a NaN, an infinity or a denormal here and there and half the lanes off (37: a run
+// stops in its middle), floats with their specials (2), half the lanes off (3). Blocks off, blocks without binding and blocks with it
+// must agree.
+VTEST(bound_binary64_runs_give_the_handlers_bits) {
+  const bool tier_was = amd::gcn::tier::enabled(), blocks_were = amd::gcn::tier::blocks(), bound_was = amd::gcn::tier::bound();
+  amd::gcn::tier::set_enabled(true);
+  uint64_t runs = 0, wrong = 0, instructions = 0, bound = 0, bound_with_lanes_off = 0;
+  for (const Target& t : {kTargets[0], kTargets[1]}) {
+    const Pools pool = pools_of(t);
+    std::vector<amd::gcn::Inst> doubles;
+    amd::gcn::tier::set_blocks(true);
+    amd::gcn::tier::set_bound(true);
+    for (const amd::gcn::Inst& in : pool.blockable) {
+      if (in.name.find("_f64") == std::string::npos) continue;
+      amd::ProgramRun run;
+      amd::digest_program({in, in, in, pool.endpgm[0]}, t.target, 1, 36, 1, 0, &run);
+      if (run.bound_in_blocks) doubles.push_back(in);
+    }
+    VCHECK(doubles.size() >= 6);
+    Rng r{0xd0b1e + static_cast<uint64_t>(t.target)};
+    for (uint64_t pn = 0; pn < 150; ++pn) {
+      std::vector<amd::gcn::Inst> program;
+      const size_t len = 10 + r.below(24);
+      for (size_t i = 0; i < len; ++i) program.push_back(r.below(8) ? doubles[r.below(doubles.size())] : pool.blockable[r.below(pool.blockable.size())]);
+      program.push_back(pool.endpgm[0]);
+      for (const uint32_t flavour : {36u, 37u, 2u, 3u}) {
+        const uint64_t slice = r.below(2) ? 0 : 1 + r.below(7);
+        const uint32_t waves = 1 + static_cast<uint32_t>(r.below(2));
+        amd::ProgramRun on_run;
+        amd::gcn::tier::set_blocks(false);
+        const uint64_t plain = amd::digest_program(program, t.target, pn, flavour, waves, slice);
+        amd::gcn::tier::set_blocks(true);
+        amd::gcn::tier::set_bound(false);
+        const uint64_t unbound = amd::digest_program(program, t.target, pn, flavour, waves, slice);
+        amd::gcn::tier::set_bound(true);
+        const uint64_t on = amd::digest_program(program, t.target, pn, flavour, waves, slice, &on_run);
+        ++runs, instructions += on_run.instructions, bound += on_run.bound_in_blocks;
+        if (flavour == 37 || flavour == 3) bound_with_lanes_off += on_run.bound_in_blocks;
+        wrong += plain != on || unbound != on;
+      }
+    }
+  }
+  amd::gcn::tier::set_bound(bound_was);
+  amd::gcn::tier::set_blocks(blocks_were);
+  amd::gcn::tier::set_enabled(tier_was);
+  std::fprintf(stderr, "bound binary64 runs: %llu runs each way, %llu instructions, %llu as bound operations (%llu with lanes off)\n",
+               static_cast<unsigned long long>(runs), static_cast<unsigned long long>(instructions), static_cast<unsigned long long>(bound),
+               static_cast<unsigned long long>(bound_with_lanes_off));
+  if (wrong) throw vtest::Failure(std::to_string(wrong) + " of " + std::to_string(runs) + " runs differ with bound binary64 operations");
+  VCHECK(bound * 8 > instructions);
+  VCHECK(bound_with_lanes_off * 40 > instructions);
+}
+
 VTEST_MAIN
